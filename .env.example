# Copy to .env and fill in. docker-compose reads this automatically.

# Domain for automatic HTTPS via Caddy. Leave as localhost for a local run.
DOMAIN=localhost

# Sandbox runtime for the tracers. Use "runsc" in production once gVisor is
# installed (infra/setup-oracle.sh); "runc" for local development.
SANDBOX_RUNTIME=runc

# Groq API key. Leave empty to disable LLM narration entirely (the app still
# works, the narration strip just stays hidden). Get one at https://console.groq.com
# This file is committed — put the real key in .env, which is gitignored.
GROQ_API_KEY=

# Groq model for narration. Any chat model available on your Groq account.
GROQ_MODEL=llama-3.3-70b-versatile


# ---------------------------------------------------------------------------
# Azure (all optional). Setup guide: infra/azure/README.md
#
# Both integrations are off unless configured, and the app is fully functional
# with every line below left blank -- that is the supported default, not a
# degraded mode. Turn them on one at a time; neither depends on the other.
# ---------------------------------------------------------------------------

# --- Durable trace storage (Azure Blob Storage) ----------------------------
# Makes traces outlive a restart, which is what makes a shared link worth
# sharing. Empty -> in-memory cache only, links die with the process.
#
# Storage account -> Security + networking -> Access keys -> Connection string.
# This is a credential: put the real value in .env, which is gitignored.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=traces

# --- Sign-in (Microsoft Entra External ID) ---------------------------------
# Set the backend pair AND the frontend trio together. Configuring only the
# backend locks out a frontend that has no way to obtain a token; only the
# frontend sends tokens nothing checks.

# Backend: which tokens to accept. The issuer is the `issuer` value from
# <authority>/.well-known/openid-configuration -- read it from there rather
# than assembling it by hand, because a mismatched trailing path is the single
# most common cause of a 401 that looks like nothing is wrong.
VISUALIZER_AZURE_AUTH_ISSUER_URI=
# The API's application (client) ID. Leave empty and any token from the tenant
# is accepted, including one issued for a different app -- fine locally, wrong
# anywhere public.
VISUALIZER_AZURE_AUTH_AUDIENCE=

# Frontend: compiled into the bundle, so these need `docker compose build`
# after a change, not just a restart. None is a secret -- a browser app holds
# no client secret, which is what PKCE is for.
VITE_AZURE_CLIENT_ID=
# External ID tenant:  https://<tenant>.ciamlogin.com/<tenant-id>
# Workforce tenant:    https://login.microsoftonline.com/<tenant-id>
# Both are supported unchanged. The workforce form is the fallback when your
# account cannot create an external tenant -- common on a university-managed
# Azure for Students subscription. See infra/azure/README.md.
VITE_AZURE_AUTHORITY=
# e.g. api://<client-id>/Trace.Run
VITE_AZURE_API_SCOPE=
