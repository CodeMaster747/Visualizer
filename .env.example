# Copy to .env and fill in. docker-compose reads this automatically.

# Domain for automatic HTTPS via Caddy. Leave as localhost for a local run.
DOMAIN=localhost

# Sandbox runtime for the tracers. Use "runsc" in production once gVisor is
# installed (infra/setup-oracle.sh); "runc" for local development.
SANDBOX_RUNTIME=runc

# Groq API key. Leave empty to disable LLM narration entirely (the app still
# works, the narration strip just stays hidden). Get one at https://console.groq.com
# This file is committed — put the real key in .env, which is gitignored.
GROQ_API_KEY=

# Groq model for narration. Any chat model available on your Groq account.
GROQ_MODEL=llama-3.3-70b-versatile
