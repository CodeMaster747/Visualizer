# Copy to .env and fill in. docker-compose reads this automatically.

# Domain for automatic HTTPS via Caddy. Leave as localhost for a local run.
DOMAIN=localhost

# Sandbox runtime for the tracers. Use "runsc" in production once gVisor is
# installed (infra/setup-oracle.sh); "runc" for local development.
SANDBOX_RUNTIME=runc

# Groq API key. Leave empty to disable LLM narration entirely (the app still
# works, the narration strip just stays hidden). Get one at https://console.groq.com
# This file is committed — put the real key in .env, which is gitignored.
GROQ_API_KEY=

# Groq model for narration. Any chat model available on your Groq account.
GROQ_MODEL=llama-3.3-70b-versatile


# ---------------------------------------------------------------------------
# Azure (all optional). Setup guide: infra/azure/README.md
#
# Both integrations are off unless configured, and the app is fully functional
# with every line below left blank -- that is the supported default, not a
# degraded mode. Turn them on one at a time; neither depends on the other.
# ---------------------------------------------------------------------------

# --- Durable trace storage (Azure Blob Storage) ----------------------------
# Makes traces outlive a restart, which is what makes a shared link worth
# sharing. Empty -> in-memory cache only, links die with the process.
#
# Storage account -> Security + networking -> Access keys -> Connection string.
# This is a credential: put the real value in .env, which is gitignored.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=traces

# --- Sign-in ---------------------------------------------------------------
# Accounts are self-hosted: the API stores users itself and issues its own
# tokens, so there is no provider to register with and NOTHING here has to be
# set for sign-up and sign-in to work. Leave the whole section empty and
# `docker compose up` gives you a working account system.
#
# There is deliberately no frontend variable to match. The browser bundle knows
# nothing about authentication at build time, so the two halves cannot be
# configured differently -- which is what used to produce a working sign-in
# screen followed by a 401 on every request, unfixable by signing in again.

# Signs the access tokens. Empty -> generated on first boot and saved to the
# backend's data directory, which survives restarts but not a rebuild that
# replaces the volume. Set it in anything long-lived so a deploy does not sign
# everyone out:
#
#   openssl rand -base64 32
#
# This is a credential: the real value belongs in .env, which is gitignored.
VISUALIZER_AUTH_SECRET=

# How long a session lasts, in minutes. There are no refresh tokens, so this is
# simply how long until someone signs in again. Default 720 (12 hours).
VISUALIZER_AUTH_TOKEN_TTL_MINUTES=720
